{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heyonecut",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "heyonecut-db", "database_id": "c0bebdbb-0d39-417c-898a-2037fe575a15" }],
  "vars": { "FREE_LIMIT": "3", "COUPON_RATE": "30", "COUPON_LAUNCH_RATE": "50", "COUPON_LAUNCH_UNTIL": "", "ADMIN_UIDS": "kakao_5140693256,naver_B7XBrhgtKsKOGFqA8w1g8v_qNzbDdFWYDz3ND615LYw,google_100677317366998248561" },
  "keep_vars": true,
  "triggers": { "crons": ["17 18 * * *"] },
  "observability": { "enabled": true }
}
